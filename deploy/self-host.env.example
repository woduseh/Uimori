# Copy to repository root as .env.self-host; do not commit real values.
# One exact HTTPS origin, with no path, trailing slash, query or fragment.
NR_PUBLIC_ORIGIN=https://story.example.com

# REQUIRED: replace the empty value with `openssl rand -hex 32` output.
NR_ACCESS_TOKEN=

# Existing TLS files for that hostname: fullchain.pem and privkey.pem.
# Use a dedicated directory. Both files must resolve inside this mount.
UIMORI_TLS_DIR=/srv/uimori/tls
UIMORI_HTTPS_PORT=443

# Outbound model API origins, independent of the browser's public origin.
# Leave empty until you configure the providers you intend to use.
NR_PROVIDER_ORIGINS=
# NR_PROVIDER_ORIGINS=https://api.openai.com,https://api.anthropic.com
# OPENAI_API_KEY=replace-with-your-server-key
# ANTHROPIC_API_KEY=replace-with-your-server-key

# Google Agent Platform credentials; see docs/PROVIDERS.md.
# Allow the selected region's API origin in NR_PROVIDER_ORIGINS.
# NR_VERTEX_REQUEST_TIER=flex
# GOOGLE_APPLICATION_CREDENTIALS=/run/uimori-secrets/service-account.json

# Optional official Codex runtime for a personal ChatGPT subscription.
# Set both, then rebuild the app image. Authentication is done in Settings > Agents.
# UIMORI_CODEX_VERSION=0.153.0
# NR_CODEX_ENABLED=1
# See docs/CODEX.md. The app's data volume retains its dedicated Codex login.
