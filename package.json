{
  "name": "uimori",
  "version": "0.0.1",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.14.0 <25"
  },
  "scripts": {
    "dev": "npm run build && node dist/server/index.js",
    "start": "node dist/server/index.js",
    "reset:dev": "node scripts/reset-dev-data.mjs",
    "check": "tsc --noEmit",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint . --error-on-warnings",
    "lint:fix": "biome lint --write . --error-on-warnings",
    "lint:architecture": "biome lint core server web --only=style/noRestrictedImports --error-on-warnings",
    "quality": "biome check . --error-on-warnings && tsc --noEmit",
    "quality:full": "npm run quality && npm run test:tooling && npm test",
    "release:check": "node scripts/release-check.mjs",
    "update": "node scripts/uimori-update.mjs",
    "release:oracle": "node scripts/release-oracle.mjs",
    "release:smoke": "node scripts/oracle-smoke.mjs",
    "build": "node scripts/build.mjs",
    "test": "vitest run",
    "test:tooling": "npm run build && node scripts/test-tooling.mjs",
    "benchmark:story": "node scripts/benchmark-story.mjs",
    "doctor": "node scripts/doctor.mjs",
    "cleanup": "node scripts/cleanup.mjs",
    "verify:ui": "node scripts/verify-ui.mjs",
    "verify:collaboration": "node scripts/verify-collaboration.mjs",
    "verify:evaluation": "node scripts/verify-evaluation.mjs",
    "verify:providers": "node scripts/verify-provider-management.mjs",
    "verify:pricing": "node scripts/verify-model-pricing.mjs",
    "verify:global-models": "node scripts/verify-global-models.mjs",
    "verify:packages": "node scripts/verify-package-ui.mjs",
    "verify:loading": "node scripts/verify-loading.mjs",
    "verify:turn-activity": "node scripts/verify-turn-activity.mjs",
    "verify:illustration": "node scripts/verify-illustration.mjs",
    "verify:navigation": "node scripts/verify-navigation.mjs",
    "verify:outline": "node scripts/verify-outline.mjs",
    "verify:library": "node scripts/verify-library.mjs",
    "verify:ui-recovery": "node scripts/verify-ui-recovery.mjs",
    "verify:browser": "node scripts/verify-browser.mjs",
    "verify:browser-smoke": "node scripts/verify-browser-smoke.mjs",
    "verify:chat-unification": "node scripts/verify-chat-unification.mjs",
    "verify:chat-backup": "node scripts/verify-chat-backup.mjs",
    "verify:diagnostics": "node scripts/verify-diagnostics.mjs",
    "verify:native-transfer": "node scripts/verify-native-transfer.mjs",
    "verify:visual": "node scripts/verify-visual.mjs",
    "verify:gallery": "node scripts/verify-gallery.mjs",
    "verify:selfhost": "node scripts/verify-self-host.mjs",
    "transfer:personal": "node scripts/transfer-personal-v1.mjs",
    "test:personal": "vitest run tests/personal-workspace-v1.test.ts tests/personal-workspace-flow.test.ts tests/database-schema.test.ts tests/access-session.test.ts",
    "verify:personal": "node scripts/verify-personal.mjs",
    "verify:themes": "node scripts/verify-themes.mjs",
    "verify:translation-guides": "node scripts/verify-translation-guides.mjs",
    "verify:input-translation": "node scripts/verify-input-translation.mjs"
  },
  "dependencies": {
    "@fastify/static": "10.1.3",
    "dompurify": "3.4.15",
    "fastify": "5.12.3",
    "google-auth-library": "11.0.2",
    "lucide-react": "1.41.0",
    "markdown-it": "15.0.2",
    "msgpackr": "1.11.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "0.35.4",
    "tiktoken": "1.0.22",
    "undici": "7.29.1",
    "wasmoon": "1.16.0"
  },
  "devDependencies": {
    "@babel/parser": "7.29.9",
    "@biomejs/biome": "2.5.12",
    "@playwright/test": "1.63.0",
    "@types/markdown-it": "14.2.0",
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  }
}
