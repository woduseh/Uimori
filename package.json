{
  "name": "uimori",
  "version": "0.18.1",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.13.0 <27"
  },
  "scripts": {
    "dev": "npm run build && node dist/server/index.js",
    "start": "node dist/server/index.js",
    "reset:dev": "node scripts/reset-dev-data.mjs",
    "check": "tsc --noEmit",
    "check:risu-lua": "node scripts/risu-lua-diff.mjs",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint . --error-on-warnings",
    "lint:fix": "biome lint --write . --error-on-warnings",
    "lint:architecture": "biome lint core server web --only=style/noRestrictedImports --error-on-warnings",
    "quality": "biome check . --error-on-warnings && tsc --noEmit && node scripts/check-comments.mjs && node scripts/check-i18n.mjs",
    "quality:full": "npm run quality && npm run test:tooling && npm test",
    "check:changed": "node scripts/check-changed.mjs",
    "check:unit-diff": "node scripts/check-unit-diff.mjs",
    "release:check": "node scripts/release-check.mjs",
    "release:oracle": "node scripts/release-oracle.mjs",
    "release:smoke": "node scripts/oracle-smoke.mjs",
    "build": "node scripts/build.mjs",
    "test": "vitest run",
    "test:tooling": "npm run build && node scripts/test-tooling.mjs",
    "test:windows": "vitest run tests/server.test.ts tests/backup-service.test.ts tests/backup-file.test.ts tests/maintenance.test.ts tests/database-schema.test.ts tests/personal-workspace-flow.test.ts tests/helper-cli.test.ts tests/helper-shell.test.ts tests/codex-process.test.ts tests/codex-runtime.test.ts tests/request-files-storage.test.ts tests/native-transfer-archive.test.ts tests/import-envelope.test.ts",
    "benchmark:story": "node scripts/benchmark-story.mjs",
    "eval:helper": "node scripts/helper-eval.mjs",
    "doctor": "node scripts/doctor.mjs",
    "cleanup": "node scripts/cleanup.mjs",
    "verify": "node scripts/verify.mjs",
    "verify:ui": "npm run verify -- reader",
    "verify:story-ui": "npm run verify -- story-ui",
    "verify:collaboration": "npm run verify -- chat-settings",
    "verify:evaluation": "npm run verify -- chat-settings",
    "verify:providers": "npm run verify -- providers",
    "verify:pricing": "npm run verify -- providers",
    "verify:global-models": "npm run verify -- prompts",
    "verify:packages": "npm run verify -- risu",
    "verify:risu-compat": "npm run verify -- risu",
    "verify:loading": "npm run verify -- loading-and-sync",
    "verify:turn-activity": "npm run verify -- turn-activity",
    "verify:illustration": "npm run verify -- illustration",
    "verify:navigation": "npm run verify -- navigation",
    "verify:outline": "npm run verify -- outline",
    "verify:library": "npm run verify -- library",
    "verify:ui-recovery": "npm run verify -- resource-editors",
    "verify:browser": "npm run verify -- all",
    "verify:browser-smoke": "npm run verify -- browser-smoke",
    "verify:chat-unification": "npm run verify -- chat-unification",
    "verify:chat-backup": "npm run verify -- personal-workspace",
    "verify:native-transfer": "npm run verify -- risu",
    "verify:visual": "npm run verify -- all --visual",
    "verify:gallery": "npm run verify -- gallery",
    "verify:copy": "npm run verify -- copy",
    "verify:selfhost": "npm run verify -- self-host",
    "test:personal": "vitest run tests/personal-workspace-flow.test.ts tests/database-schema.test.ts tests/access-session.test.ts",
    "verify:personal": "npm run verify -- personal-workspace",
    "verify:themes": "npm run verify -- appearance",
    "verify:translation-guides": "npm run verify -- translation",
    "verify:input-translation": "npm run verify -- translation",
    "verify:narrative-themes": "npm run verify -- appearance",
    "verify:liquid-gallery": "npm run verify -- appearance",
    "verify:personal-features": "npm run verify -- personal-workspace",
    "verify:push": "npm run verify -- personal-workspace",
    "verify:i18n": "npm run verify -- i18n",
    "check:i18n": "node scripts/check-i18n.mjs"
  },
  "dependencies": {
    "@a2ui/agent": "0.1.0",
    "@a2ui/react": "0.15.0",
    "@a2ui/web_core": "0.15.0",
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-html": "6.4.12",
    "@codemirror/language": "6.13.1",
    "@codemirror/legacy-modes": "6.5.5",
    "@codemirror/lint": "6.9.8",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@fastify/compress": "9.3.0",
    "@fastify/static": "10.1.11",
    "@huggingface/tokenizers": "0.2.0",
    "@lezer/highlight": "1.2.5",
    "dompurify": "3.4.18",
    "fastify": "5.12.8",
    "google-auth-library": "11.3.4",
    "intl-messageformat": "12.2.0",
    "lucide-react": "1.75.0",
    "markdown-it": "15.0.3",
    "msgpackr": "2.1.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "stream-json": "3.9.0",
    "tiktoken": "1.0.22",
    "undici": "8.12.4",
    "wasmoon": "1.16.0",
    "web-push": "4.0.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@babel/parser": "8.1.2",
    "@biomejs/biome": "2.5.12",
    "@playwright/test": "1.65.1",
    "@types/markdown-it": "14.2.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/web-push": "3.6.4",
    "@vitejs/plugin-react": "6.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  },
  "overrides": {
    "@a2ui/markdown-it": {
      "@a2ui/web_core": "$@a2ui/web_core"
    }
  }
}
