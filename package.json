{
  "name": "uimori",
  "version": "0.13.4",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.13.0 <27"
  },
  "scripts": {
    "dev": "npm run build && node dist/server/index.js",
    "start": "node dist/server/index.js",
    "reset:dev": "node scripts/reset-dev-data.mjs",
    "check": "tsc --noEmit",
    "check:risu-lua": "node scripts/risu-lua-diff.mjs",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint . --error-on-warnings",
    "lint:fix": "biome lint --write . --error-on-warnings",
    "lint:architecture": "biome lint core server web --only=style/noRestrictedImports --error-on-warnings",
    "quality": "biome check . --error-on-warnings && tsc --noEmit",
    "quality:full": "npm run quality && npm run test:tooling && npm test",
    "release:check": "node scripts/release-check.mjs",
    "release:oracle": "node scripts/release-oracle.mjs",
    "release:smoke": "node scripts/oracle-smoke.mjs",
    "build": "node scripts/build.mjs",
    "test": "vitest run",
    "test:tooling": "npm run build && node scripts/test-tooling.mjs",
    "test:windows": "vitest run tests/server.test.ts tests/backup-service.test.ts tests/backup-file.test.ts tests/maintenance.test.ts tests/database-schema.test.ts tests/personal-workspace-flow.test.ts tests/helper-cli.test.ts tests/helper-shell.test.ts tests/codex-process.test.ts tests/codex-runtime.test.ts tests/request-files-storage.test.ts tests/native-transfer-archive.test.ts tests/import-envelope.test.ts",
    "benchmark:story": "node scripts/benchmark-story.mjs",
    "eval:helper": "node scripts/helper-eval.mjs",
    "doctor": "node scripts/doctor.mjs",
    "cleanup": "node scripts/cleanup.mjs",
    "verify:ui": "node scripts/verify-ui.mjs",
    "verify:story-ui": "node scripts/verify-story-ui.mjs",
    "verify:collaboration": "node scripts/verify-collaboration.mjs",
    "verify:evaluation": "node scripts/verify-evaluation.mjs",
    "verify:providers": "node scripts/verify-provider-management.mjs",
    "verify:pricing": "node scripts/verify-model-pricing.mjs",
    "verify:global-models": "node scripts/verify-global-models.mjs",
    "verify:packages": "node scripts/verify-package-ui.mjs",
    "verify:risu-compat": "node scripts/verify-risu-compat.mjs",
    "verify:loading": "node scripts/verify-loading.mjs",
    "verify:turn-activity": "node scripts/verify-turn-activity.mjs",
    "verify:illustration": "node scripts/verify-illustration.mjs",
    "verify:navigation": "node scripts/verify-navigation.mjs",
    "verify:outline": "node scripts/verify-outline.mjs",
    "verify:library": "node scripts/verify-library.mjs",
    "verify:ui-recovery": "node scripts/verify-ui-recovery.mjs",
    "verify:browser": "node scripts/verify-browser.mjs",
    "verify:browser-smoke": "node scripts/verify-browser-smoke.mjs",
    "verify:chat-unification": "node scripts/verify-chat-unification.mjs",
    "verify:chat-backup": "node scripts/verify-chat-backup.mjs",
    "verify:native-transfer": "node scripts/verify-native-transfer.mjs",
    "verify:visual": "node scripts/verify-visual.mjs",
    "verify:gallery": "node scripts/verify-gallery.mjs",
    "verify:copy": "node scripts/check-ui-copy.mjs",
    "verify:selfhost": "node scripts/verify-self-host.mjs",
    "test:personal": "vitest run tests/personal-workspace-flow.test.ts tests/database-schema.test.ts tests/access-session.test.ts",
    "verify:personal": "node scripts/verify-personal.mjs",
    "verify:themes": "node scripts/verify-themes.mjs",
    "verify:translation-guides": "node scripts/verify-translation-guides.mjs",
    "verify:input-translation": "node scripts/verify-input-translation.mjs",
    "verify:narrative-themes": "node scripts/verify-narrative-themes.mjs",
    "verify:liquid-gallery": "node scripts/verify-liquid-gallery.mjs",
    "verify:personal-features": "node scripts/verify-personal-features.mjs",
    "verify:push": "node scripts/verify-push.mjs",
    "verify:i18n": "node scripts/verify-i18n.mjs",
    "check:i18n": "node scripts/check-i18n.mjs"
  },
  "dependencies": {
    "@a2ui/agent": "0.1.0",
    "@a2ui/react": "0.15.0",
    "@a2ui/web_core": "0.15.0",
    "@fastify/static": "10.1.11",
    "@huggingface/tokenizers": "0.2.0",
    "dompurify": "3.4.18",
    "fastify": "5.12.8",
    "google-auth-library": "11.3.4",
    "intl-messageformat": "12.2.0",
    "lucide-react": "1.75.0",
    "markdown-it": "15.0.3",
    "msgpackr": "2.1.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "stream-json": "3.9.0",
    "tiktoken": "1.0.22",
    "undici": "8.12.4",
    "wasmoon": "1.16.0",
    "web-push": "4.0.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@babel/parser": "8.1.2",
    "@biomejs/biome": "2.5.12",
    "@playwright/test": "1.65.1",
    "@types/markdown-it": "14.2.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/web-push": "3.6.4",
    "@vitejs/plugin-react": "6.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  },
  "overrides": {
    "@a2ui/markdown-it": {
      "@a2ui/web_core": "$@a2ui/web_core"
    }
  }
}
