{
  "name": "uimori",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.14.0 <25"
  },
  "scripts": {
    "dev": "npm run build && node dist/server/index.js",
    "start": "node dist/server/index.js",
    "reset:dev": "node scripts/reset-dev-data.mjs",
    "check": "tsc --noEmit",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint . --error-on-warnings",
    "lint:fix": "biome lint --write . --error-on-warnings",
    "lint:architecture": "biome lint core server web --only=style/noRestrictedImports --error-on-warnings",
    "quality": "biome check . --error-on-warnings && tsc --noEmit",
    "quality:full": "npm run quality && npm run test:tooling && npm run build && npm test",
    "build": "node scripts/build.mjs",
    "test": "vitest run",
    "test:tooling": "node scripts/test-tooling.mjs",
    "benchmark:story": "node scripts/benchmark-story.mjs",
    "doctor": "node scripts/doctor.mjs",
    "verify": "node scripts/verify.mjs",
    "verify:smoke": "node scripts/verify.mjs --case F02,F03,F06",
    "verify:selftest": "node scripts/selftest.mjs",
    "cleanup": "node scripts/cleanup.mjs",
    "verify:ui": "node scripts/verify-ui.mjs",
    "verify:collaboration": "node scripts/verify-collaboration.mjs",
    "verify:evaluation": "node scripts/verify-evaluation.mjs",
    "verify:providers": "node scripts/verify-provider-management.mjs",
    "verify:global-models": "node scripts/verify-global-models.mjs",
    "verify:packages": "node scripts/verify-package-ui.mjs",
    "verify:loading": "node scripts/verify-loading.mjs",
    "verify:turn-activity": "node scripts/verify-turn-activity.mjs",
    "verify:navigation": "node scripts/verify-navigation.mjs",
    "verify:library": "node scripts/verify-library.mjs",
    "verify:redesign": "node scripts/verify-redesign.mjs",
    "verify:browser-smoke": "node scripts/verify-browser-smoke.mjs",
    "verify:visual": "node scripts/verify-visual.mjs",
    "verify:selfhost": "node scripts/verify-self-host.mjs"
  },
  "dependencies": {
    "@fastify/static": "10.1.3",
    "fastify": "5.12.3",
    "google-auth-library": "11.0.2",
    "lucide-react": "1.41.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tiktoken": "1.0.22",
    "undici": "7.29.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@playwright/test": "1.63.0",
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  }
}
