{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "jsx": "react-jsx",
    "strict": true,
    "erasableSyntaxOnly": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node", "vite/client"],
    "paths": {
      "#contracts": ["./packages/contracts/src/index.ts"],
      "#contracts/operations": ["./packages/contracts/src/operations.ts"],
      "#dist/*": ["./*"]
    },
    "noEmit": true,
    "allowJs": true,
    "allowImportingTsExtensions": true
  },
  "include": ["core", "packages", "server", "web", "tests", "scripts", "*.config.ts"]
}
